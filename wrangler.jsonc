{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "datacooker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "upload_source_maps": true,
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://uzycjdnivcfnfpjcpubi.supabase.co",
    "WORKER_ID": "cloudflare-browser-run",
    "TIKTOK_BS_ID_MAP": "{}"
  },
  "observability": {
    "enabled": true
  }
}
